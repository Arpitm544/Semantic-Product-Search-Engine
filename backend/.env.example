# Copy to .env; the API loads this file without overriding shell exports.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/
MONGO_DB_NAME=semantic_product_search
MONGO_COLLECTION=amazon_products
ATLAS_VECTOR_INDEX=product_vectors
SEMANTIC_MODEL_PATH=models/colab-export/esci-minilm-20k
RERANKER_MODEL_PATH=models/ms-marco-MiniLM-L6-v2
PORT=8000
FRONTEND_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Google Shopping via SerpApi (optional; keep this key on the backend only).
SERPAPI_API_KEY=
SERPAPI_COUNTRY=in
SERPAPI_LANGUAGE=en
# Optional city/country, e.g. Mumbai, Maharashtra, India
SERPAPI_LOCATION=

# Clerk Frontend API origin from Dashboard > API keys (not your website URL).
# Required for standalone API startup. The npm dev launcher can derive it from
# the public frontend publishable key. Never derive it from an incoming token.
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev

# Shopify single-store search (backend secrets only)
SHOPIFY_ENABLED=false
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_COLLECTION_GID=
SHOPIFY_SYNC_MAX_PRODUCTS=500
SHOPIFY_HYDRATION_TTL_SECONDS=60
