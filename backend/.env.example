# Copy to .env; the API loads this file without overriding shell exports.
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=semantic_product_search
MONGO_AMAZON_COLLECTION=amazon_products
SEMANTIC_MODEL_PATH=models/colab-export/esci-minilm-20k
RERANKER_MODEL_PATH=models/ms-marco-MiniLM-L6-v2
PORT=8000
FRONTEND_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Optional live marketplace APIs (backend only)
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_CREDENTIAL_VERSION=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.in
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
