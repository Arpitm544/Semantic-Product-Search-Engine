# Copy to .env; the API loads this file without overriding shell exports.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/
MONGO_DB_NAME=semantic_product_search
MONGO_COLLECTION=amazon_products
ATLAS_VECTOR_INDEX=product_vectors
SEMANTIC_MODEL_PATH=models/colab-export/esci-minilm-20k
RERANKER_MODEL_PATH=models/ms-marco-MiniLM-L6-v2
PORT=8000
FRONTEND_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Google Shopping via SerpApi (optional; keep this key on the backend only).
SERPAPI_API_KEY=
SERPAPI_COUNTRY=in
SERPAPI_LANGUAGE=en
# Optional city/country, e.g. Mumbai, Maharashtra, India
SERPAPI_LOCATION=

# Free online-shop search (source=shops). Each shop turns on once its keys are
# set; leave a shop's keys empty to skip it. Keep all keys on the backend only.
# eBay: free developer account at developer.ebay.com, production keyset.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Marketplace to search, e.g. EBAY_US, EBAY_GB, EBAY_DE, EBAY_AU.
EBAY_MARKETPLACE_ID=EBAY_US
# Flipkart: free affiliate account at affiliate.flipkart.com (tracking ID + API token).
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
# Daily search-call caps per shop (per backend process; reset at UTC midnight).
EBAY_DAILY_CALLS=4000
FLIPKART_DAILY_CALLS=5000

# Clerk Frontend API origin from Dashboard > API keys (not your website URL).
# Required for standalone API startup. The npm dev launcher can derive it from
# the public frontend publishable key. Never derive it from an incoming token.
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev

# Opt-in in-app price alerts. Set 0 when using an external host/cron scheduler.
PRICE_ALERTS_ENABLED=1
# Six hours between checks of each alert; minimum accepted interval is one hour.
PRICE_ALERT_INTERVAL_SECONDS=21600

# Per-user fixed-window search limits (MongoDB shared counters; minimum 1).
CATALOG_SEARCHES_PER_MINUTE=30
SHOPPING_SEARCHES_PER_MINUTE=5
SHOPS_SEARCHES_PER_MINUTE=10
